environments:
  default:
    values:
      - environments/default.yaml

---

repositories:
  - name: crossplane-stable
    url: https://charts.crossplane.io/stable

helmDefaults:
  wait: true
  timeout: 600
  createNamespace: false   # namespaces are created by the 'namespaces' release

releases:
  - name: namespaces
    namespace: default
    chart: ./charts/namespaces

  # --- Cluster authentication (htpasswd identity provider) ------------------
  # Neither oauth/cluster nor its backing htpasswd Secret can be Helm-owned
  # templates: both pre-exist on every OpenShift cluster (the singleton is
  # owned by the cluster-version-operator, and the Secret is normally set up
  # out of band before this platform ever touches the cluster) — templating
  # either would hit the same "invalid ownership metadata" conflict documented
  # in CLAUDE.md for pre-existing Namespaces/Secrets. So this chart carries no
  # templated resources at all; a postsync hook does the work, merging our
  # users into whatever HTPasswd provider already exists (falling back to
  # bootstrapping one only if the cluster has none) — see apply-oauth.sh and
  # CLAUDE.md. No `needs:` of its own (openshift-config always exists), but
  # temporal-stack below needs it — the Temporal UI's oauth-proxy only admits
  # cluster-admins, so the grant must land before that Route comes up.
  - name: htpasswd-idp
    namespace: openshift-config
    chart: ./charts/htpasswd-idp
    hooks:
      - events: [postsync]
        showlogs: true
        command: ./charts/htpasswd-idp/scripts/apply-oauth.sh
        args:
          - {{ .Values.htpasswdIdp.bootstrapProviderName | quote }}
          - {{ .Values.htpasswdIdp.bootstrapSecretName | quote }}
          - |
            {{- range .Values.htpasswdIdp.users }}
            {{ htpasswd .username .password }}
            {{- end }}
          {{- range .Values.htpasswdIdp.clusterAdmins }}
          - {{ . | quote }}
          {{- end }}

  # --- Crossplane core ------------------------------------------------------
  - name: crossplane
    namespace: crossplane-system
    chart: crossplane-stable/crossplane
    version: {{ .Values.crossplane.version | quote }}
    needs:
      - default/namespaces

  # --- provider-http: Provider package, then ProviderConfig -----------------
  - name: provider-http
    namespace: crossplane-system
    chart: ./charts/provider-http
    needs:
      - crossplane-system/crossplane
    hooks:
      - events: [presync]
        showlogs: true
        command: kubectl
        args: ["wait", "--for=condition=Established", "crd/providers.pkg.crossplane.io", "--timeout=120s"]
    values:
      - provider:
          enabled: true
          package: {{ .Values.providerHttp.package | quote }}
          packagePullSecrets: {{ .Values.providerHttp.packagePullSecrets | toJson }}
        providerConfig:
          enabled: false

  - name: provider-http-config
    namespace: crossplane-system
    chart: ./charts/provider-http
    needs:
      - crossplane-system/provider-http
    hooks:
      # ProviderConfig CRD only exists once the provider is installed & healthy.
      - events: [presync]
        showlogs: true
        command: kubectl
        args: ["wait", "--for=condition=Healthy", "provider.pkg.crossplane.io/provider-http", "--timeout=300s"]
    values:
      - provider:
          enabled: false
        providerConfig:
          enabled: true
          name: {{ .Values.providerHttp.providerConfigName | quote }}

  # --- Temporal stack -------------------------------------------------------
  - name: temporal-postgresql
    namespace: temporal
    chart: ./charts/temporal-postgresql
    needs:
      - default/namespaces
    values:
      - postgresql:
          auth:
            postgresPassword: {{ .Values.temporalPostgresql.password | quote }}

  - name: temporal-stack
    namespace: temporal
    chart: git::https://github.com/team-redbull/temporal-stack.git@.?ref={{ .Values.refs.temporalStack }}
    needs:
      - default/namespaces
      - temporal/temporal-postgresql
      - openshift-config/htpasswd-idp
    values:
      - postgresql:
          enabled: false
        database:
          host: temporal-postgresql
          existingSecret: temporal-postgresql
        ui:
          auth:
            # "Log in with OpenShift" in front of the Temporal UI: an
            # oauth-proxy sidecar authenticates cluster users before the UI
            # is reachable through the Route.
            enabled: true
            # Admit ONLY the platform's own admin account(s) BY NAME, not
            # "any cluster-admin". A SAR gate can't express this: cluster-admin
            # is unconditional verb=*/resource=*, so it satisfies every SAR —
            # there's no SAR that admits one cluster-admin while excluding the
            # cluster's other admins. So gate on identity instead: an nginx
            # sidecar 403s anyone whose authenticated username isn't in this
            # list (see temporal-stack ui.auth.allowedUsers). Reuses the same
            # htpasswdIdp.clusterAdmins list this platform grants cluster-admin
            # to (currently just ocpadmin) as the single source of truth for
            # "the platform's privileged accounts". To let a cluster-admin in
            # WITHOUT giving them UI access (or vice versa), set an explicit
            # list here instead of referencing clusterAdmins.
            allowedUsers: {{ .Values.htpasswdIdp.clusterAdmins | toJson }}

  # --- segments-manager -------------------------------------------------------
  # segments-manager starts.
  - name: segments-manager-mongodb
    namespace: segments-manager
    chart: ./charts/segments-manager-mongodb
    needs:
      - default/namespaces
    values:
      - mongodb:
          auth:
            rootPassword: {{ .Values.segmentsManagerMongodb.rootPassword | quote }}
            passwords:
              - {{ .Values.segmentsManagerMongodb.password | quote }}

  - name: segments-manager
    namespace: segments-manager
    chart: git::https://github.com/team-redbull/segments-manager.git@deploy/helm?ref={{ .Values.refs.segmentManager }}
    needs:
      - default/namespaces
      - segments-manager/segments-manager-mongodb
    values:
      - config:
          # Cross-namespace URL of the shared workflow trigger API
          # (workflow-worker release's `workflows-api` Service in
          # redbull-workflows). Segment creation POSTs here to start the
          # workflow. Must be the Service FQDN — a bare `workflows-api`
          # would resolve inside the segments-manager namespace, where no
          # such Service exists.
          connectivityWorkflowApiUrl: {{ .Values.segmentsManager.connectivityWorkflowApiUrl | quote }}
        mongodb:
          url: "mongodb://segments_manager:{{ .Values.segmentsManagerMongodb.password }}@segments-mongodb.segments-manager.svc.cluster.local:27017/segments_manager?authSource=segments_manager"
          dbName: segments_manager

  # --- workflow-worker (the Temporal workflow "brain") ----------------------
  # ONE release, shared by every workflow domain (not per-domain). Deploys into
  # redbull-workflows, pre-created by the namespaces release like every other
  # app namespace — this chart has no templates/namespace.yaml of its own and
  # takes no createNamespace value, so there's no ownership collision to guard
  # against (same failure mode as the segments-manager-mongodb Secret collision
  # documented in CLAUDE.md, avoided here by construction). The chart's own
  # values.yaml carries image.repository/tag (bumped by CI in
  # team-redbull/workflows) — not overridden here.
  - name: workflow-worker
    namespace: redbull-workflows
    chart: git::https://github.com/team-redbull/workflows.git@helm/workflow-worker?ref={{ .Values.refs.workflows }}
    needs:
      - default/namespaces
      - temporal/temporal-stack
    values:
      # This release owns `orchestrator-config`, the GLOBAL ConfigMap every
      # workflow domain shares. The brain itself uses only the Temporal values;
      # domain + segmentsManagerUrl are published here so the activity limbs
      # (connectivity, and any future domain) mount them without duplication.
      - config:
          temporalHost: {{ .Values.temporal.host | quote }}
          temporalNamespace: {{ .Values.temporal.namespace | quote }}
          domain: {{ .Values.orchestrator.domain | quote }}
          segmentsManagerUrl: {{ .Values.orchestrator.segmentsManagerUrl | quote }}

  # --- mock-connectivity (test-only stand-in for the real "next" service) --
  # e2e/test environments ONLY — never install alongside a production
  # `connectivity` release. Same redbull-workflows namespace, same "no
  # Namespace of its own" story — see comment above. connectivity's
  # `nextUrl` below points at this release's in-cluster Service.
  - name: mock-connectivity
    namespace: redbull-workflows
    chart: git::https://github.com/team-redbull/workflows.git@helm/mock-connectivity?ref={{ .Values.refs.workflows }}
    needs:
      - default/namespaces

  # --- connectivity (the connectivity-activity limb) ------------------------
  # One chart per workflow domain (this is the first of what will be several).
  # Same redbull-workflows namespace as workflow-worker, same "no Namespace of
  # its own" story — see comment above.
  - name: connectivity
    namespace: redbull-workflows
    chart: git::https://github.com/team-redbull/workflows.git@helm/connectivity?ref={{ .Values.refs.workflows }}
    needs:
      - default/namespaces
      - temporal/temporal-stack
      - segments-manager/segments-manager
      - redbull-workflows/workflow-worker
      - redbull-workflows/mock-connectivity
    values:
      # Only the connectivity-specific endpoints live here. The Temporal
      # connection, DOMAIN and SEGMENTS_MANAGER_URL come from the shared
      # `orchestrator-config` (owned by the workflow-worker release above, which
      # this release `needs:`), which the activity worker also mounts.
      - config:
          nextUrl: {{ .Values.connectivityWorkflow.nextUrl | quote }}
          nextTokenRenewalUri: {{ .Values.connectivityWorkflow.nextTokenRenewalUri | quote }}
          nextOpenRulesUri: {{ .Values.connectivityWorkflow.nextOpenRulesUri | quote }}
          nextCheckStatusUri: {{ .Values.connectivityWorkflow.nextCheckStatusUri | quote }}
        secrets:
          # The connectivity worker authenticates its mutating Segments Manager
          # calls with an out-of-band Secret (key SEGMENTS_MANAGER_API_TOKEN),
          # created once in-cluster and holding the SAME value as
          # segments-manager's own `segments-manager-api-token` Secret. The token
          # never passes through git or Helm values. See README/CLAUDE.md.
          existingSecret: {{ .Values.connectivityWorkflow.segmentsManagerTokenSecret | quote }}

  # --- BareMetalHost generator operator -------------------------------------
  - name: bmh-generator-operator
    namespace: bmh-system
    chart: git::https://github.com/team-redbull/BareMetalHostUCS.git@deploy/helm/bmh-generator-operator?ref={{ .Values.refs.bmh }}
    needs:
      - default/namespaces

  # --- Server scanner dashboard ---------------------------------------------
  - name: server-scanner-dashboard
    namespace: server-scanner
    chart: git::https://github.com/team-redbull/ServerScanner.git@deploy/helm/server-scanner-dashboard?ref={{ .Values.refs.serverScanner }}
    needs:
      - default/namespaces

  # --- DHCP scope integration (Crossplane Requests via provider-http) -------
  - name: hosted-cluster-integration
    namespace: crossplane-system
    chart: git::https://github.com/team-redbull/dhcp_scope_manager.git@helm?ref={{ .Values.refs.dhcp }}
    needs:
      - crossplane-system/provider-http-config
    values:
      - crossplane:
          namespace: crossplane-system
          providerConfigName: {{ .Values.providerHttp.providerConfigName | quote }}
        apiServer:
          url: {{ .Values.dhcp.apiUrl | quote }}
