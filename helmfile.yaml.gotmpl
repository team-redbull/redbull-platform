environments:
  default:
    values:
      - environments/default.yaml

---

repositories:
  - name: crossplane-stable
    url: https://charts.crossplane.io/stable

helmDefaults:
  wait: true
  timeout: 600
  createNamespace: false   # namespaces are created by the 'namespaces' release

releases:
  - name: namespaces
    namespace: default
    chart: ./charts/namespaces

  # --- Cluster authentication (htpasswd identity provider) ------------------
  # Neither oauth/cluster nor its backing htpasswd Secret can be Helm-owned
  # templates: both pre-exist on every OpenShift cluster (the singleton is
  # owned by the cluster-version-operator, and the Secret is normally set up
  # out of band before this platform ever touches the cluster) — templating
  # either would hit the same "invalid ownership metadata" conflict documented
  # in CLAUDE.md for pre-existing Namespaces/Secrets. So this chart carries no
  # templated resources at all; a postsync hook does the work, merging our
  # users into whatever HTPasswd provider already exists (falling back to
  # bootstrapping one only if the cluster has none) — see apply-oauth.sh and
  # CLAUDE.md. No `needs:` of its own (openshift-config always exists), but
  # temporal-stack below needs it — the Temporal UI's oauth-proxy only admits
  # cluster-admins, so the grant must land before that Route comes up.
  - name: htpasswd-idp
    namespace: openshift-config
    chart: ./charts/htpasswd-idp
    hooks:
      - events: [postsync]
        showlogs: true
        command: ./charts/htpasswd-idp/scripts/apply-oauth.sh
        args:
          - {{ .Values.htpasswdIdp.bootstrapProviderName | quote }}
          - {{ .Values.htpasswdIdp.bootstrapSecretName | quote }}
          - |
            {{- range .Values.htpasswdIdp.users }}
            {{ htpasswd .username .password }}
            {{- end }}
          {{- range .Values.htpasswdIdp.clusterAdmins }}
          - {{ . | quote }}
          {{- end }}

  # --- Crossplane core ------------------------------------------------------
  # The upstream chart pins runAsUser/runAsGroup to 65532. On OpenShift that is
  # rejected outright: the `restricted-v2` SCC allocates each namespace its own
  # UID range (e.g. 1000970000-1000979999) and 65532 falls outside it, so the
  # ReplicaSets never create a pod ("unable to validate against any security
  # context constraint") and the release fails on helmDefaults.wait. Nulling both
  # IDs drops the fields from the manifest entirely, letting the SCC assign an
  # in-range UID and mutate in the capabilities/seccomp defaults it requires.
  # Prefer this over granting the SAs the nonroot-v2 SCC — that would be an
  # imperative, per-cluster step, and this bootstrap must work on any cluster.
  - name: crossplane
    namespace: crossplane-system
    chart: crossplane-stable/crossplane
    version: {{ .Values.crossplane.version | quote }}
    needs:
      - default/namespaces
    values:
      - securityContextCrossplane:
          runAsUser: null
          runAsGroup: null
        securityContextRBACManager:
          runAsUser: null
          runAsGroup: null

  # --- provider-http: Provider package, then ProviderConfig -----------------
  - name: provider-http
    namespace: crossplane-system
    chart: ./charts/provider-http
    needs:
      - crossplane-system/crossplane
    hooks:
      - events: [presync]
        showlogs: true
        command: kubectl
        args: ["wait", "--for=condition=Established", "crd/providers.pkg.crossplane.io", "--timeout=120s"]
    values:
      - provider:
          enabled: true
          package: {{ .Values.providerHttp.package | quote }}
          packagePullSecrets: {{ .Values.providerHttp.packagePullSecrets | toJson }}
        providerConfig:
          enabled: false

  - name: provider-http-config
    namespace: crossplane-system
    chart: ./charts/provider-http
    needs:
      - crossplane-system/provider-http
    hooks:
      # ProviderConfig CRD only exists once the provider is installed & healthy.
      - events: [presync]
        showlogs: true
        command: kubectl
        args: ["wait", "--for=condition=Healthy", "provider.pkg.crossplane.io/provider-http", "--timeout=300s"]
    values:
      - provider:
          enabled: false
        providerConfig:
          enabled: true
          name: {{ .Values.providerHttp.providerConfigName | quote }}

  # --- Temporal stack -------------------------------------------------------
  # MOVED TO ARGO CD. `temporal-postgresql` + `temporal-stack` are now a single
  # combined `temporal` chart in helm-charts-temporal, deployed by the redbull-services
  # ApplicationSet (gitops/services/dev/temporal). PostgreSQL is bundled as a subchart —
  # safe under Argo because sync waves express Postgres->schema->server ordering (no
  # helmDefaults.wait deadlock). See gitops/ and CLAUDE.md "Combined temporal chart".

  # --- segments-manager MongoDB (segments-manager itself is on Argo CD) -------
  - name: segments-manager-mongodb
    namespace: segments-manager
    chart: ./charts/segments-manager-mongodb
    needs:
      - default/namespaces
    values:
      - mongodb:
          auth:
            rootPassword: {{ .Values.segmentsManagerMongodb.rootPassword | quote }}
            passwords:
              - {{ .Values.segmentsManagerMongodb.password | quote }}

  # segments-manager itself MOVED TO ARGO CD (chart in helm-charts-segments-manager,
  # deployed by the redbull-services ApplicationSet — gitops/services/dev/segments-manager).
  # Only its in-cluster MongoDB stays here: the app's DB must exist before its pods start,
  # and this is a plain Bitnami release with no schema-job pattern of its own.

  # --- workflows + segment-lifecycle MOVED TO ARGO CD --------------------
  # The workflow "brain" (helm-charts-workflows) and the segment-lifecycle limb
  # (helm-charts-segment-lifecycle) are now Argo apps (gitops/services/dev/workflows,
  # gitops/services/dev/segment-lifecycle). The Temporal endpoint + orchestrator
  # globals they share live once in gitops/values/dev.yaml. Only `mock-segment-connectivity`
  # (test-only) stays on Helmfile below — segment-lifecycle's `nextUrl` points at it.

  # --- mock-segment-connectivity (test-only stand-in for the real "next" service) --
  # e2e/test environments ONLY — never install alongside a production
  # `segment-lifecycle` release. Same redbull-workflows namespace as the Argo-managed
  # workflows/segment-lifecycle apps. The Argo `segment-lifecycle` app's `nextUrl`
  # (gitops/services/dev/segment-lifecycle/values.yaml) points at this release's Service.
  - name: mock-segment-connectivity
    namespace: redbull-workflows
    chart: git::https://github.com/team-redbull/workflows.git@helm/mock-segment-connectivity?ref={{ .Values.refs.workflows }}
    needs:
      - default/namespaces

  # --- BareMetalHost generator operator -------------------------------------
  - name: bmh-generator-operator
    namespace: bmh-system
    chart: git::https://github.com/team-redbull/BareMetalHostUCS.git@deploy/helm/bmh-generator-operator?ref={{ .Values.refs.bmh }}
    needs:
      - default/namespaces

  # --- Server scanner dashboard ---------------------------------------------
  - name: server-scanner-dashboard
    namespace: server-scanner
    chart: git::https://github.com/team-redbull/ServerScanner.git@deploy/helm/server-scanner-dashboard?ref={{ .Values.refs.serverScanner }}
    needs:
      - default/namespaces

  # --- DHCP scope integration (Crossplane Requests via provider-http) -------
  - name: hosted-cluster-integration
    namespace: crossplane-system
    chart: git::https://github.com/team-redbull/dhcp_scope_manager.git@helm?ref={{ .Values.refs.dhcp }}
    needs:
      - crossplane-system/provider-http-config
    values:
      - crossplane:
          namespace: crossplane-system
          providerConfigName: {{ .Values.providerHttp.providerConfigName | quote }}
        apiServer:
          url: {{ .Values.dhcp.apiUrl | quote }}
